{
  "name": "advanced-env-manager",
  "version": "1.0.4",
  "description": "Advanced secure environment variable manager for local and server development",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emorilebo/advanced-env-manager.git"
  },
  "keywords": [
    "validation",
    "secrets",
    ".env",
    "security",
    "dotenv",
    "config",
    "variables"
  ],
  "author": "Godfrey Lebo",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/emorilebo/advanced-env-manager/issues"
  },
  "homepage": "https://github.com/emorilebo/advanced-env-manager#readme",
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.490.0",
    "dotenv": "^16.3.1",
    "joi": "^17.6.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.45.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^4.9.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ]
}
